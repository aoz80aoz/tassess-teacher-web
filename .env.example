# Copy to .env.local and fill in. .env.local is never committed.

# --- Server only (never sent to the browser) ---
# true: every API call is answered by the dummy data in src/server/mocks.
# false: calls go to API_BASE_URL with API_KEY.
USE_MOCK_API=true
API_BASE_URL=https://teacher.taseese.org/api
API_KEY=

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FILES_BASE_URL=https://teacher.taseese.org
# Google Tag Manager container, e.g. GTM-XXXXXXX. Empty: GTM is not loaded.
NEXT_PUBLIC_GTM_ID=
# App store links used by the landing page and the smart banner.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# Shows the "dummy data" hints on payment. Set false with the real API.
NEXT_PUBLIC_DEMO_MODE=true
